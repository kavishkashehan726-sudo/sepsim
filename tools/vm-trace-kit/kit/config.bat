@echo off
rem Edit these two lines if your paths are different.
rem You can find both in SEPSim: Edit > Settings > ModelSim tab.

rem Folder where SEPSim Beta is installed (the one that contains SEPSim.exe and the "work" folder)
set SEPSIM_DIR=C:\Program Files\SEPSim Beta

rem Full path of vsim.exe (the "Executable" folder in SEPSim settings, plus \vsim.exe).
rem If this file does not exist, vsim.exe is looked up on the PATH instead.
set VSIM_EXE=C:\Modeltech_xe_starter\win32xoem\vsim.exe
