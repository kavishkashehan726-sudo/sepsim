{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SEPSim",
  "version": "0.1.0",
  "identifier": "io.github.kavishkashehan726.sepsim",
  "build": {
    "frontendDist": "../../../packages/sep-app/dist"
  },
  "app": {
    "windows": [
      {
        "title": "SEPSim",
        "width": 1280,
        "height": 860,
        "minWidth": 800,
        "minHeight": 500,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "SEPSim contributors",
    "copyright": "SEPSim contributors",
    "shortDescription": "Simulator for the SEP processor",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": { "type": "offlineInstaller", "silent": true },
      "nsis": {
        "installMode": "both",
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}
