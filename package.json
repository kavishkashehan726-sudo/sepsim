{
  "name": "sepsim",
  "private": true,
  "description": "Offline desktop rebuild of the SEPSim processor simulator",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @sepsim/app",
    "build": "npm run build -w @sepsim/app",
    "test": "npm test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  }
}
